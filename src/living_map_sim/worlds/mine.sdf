<?xml version="1.0"?><sdf version="1.10"><world name="living_map_mine"><scene><ambient>0.6 0.6 0.6 1</ambient><background>0.75 0.8 0.85 1</background><shadows>false</shadows></scene><physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics><plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/><plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/><plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/><plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin><light type="directional" name="sun"><pose>0 0 10 0 0 0</pose><diffuse>.7 .7 .7 1</diffuse><direction>-.5 .2 -1</direction></light>
<model name="floor"><static>true</static><link name="l"><collision name="c"><geometry><box><size>30 20 .1</size></box></geometry></collision><visual name="v"><geometry><box><size>30 20 .1</size></box></geometry><material><ambient>.16 .15 .13 1</ambient><diffuse>.16 .15 .13 1</diffuse></material></visual></link></model>
<!-- Maze walls: entrance at x=-12, loop in centre, victim east, gas north branch, fire south. -->
<model name="wall0"><static>true</static><pose>-2 5 .75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>24 0.35 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>24 0.35 1.5</size></box></geometry><material><ambient>.28 .25 .20 1</ambient><diffuse>.28 .25 .20 1</diffuse></material></visual></link></model>
<model name="wall1"><static>true</static><pose>-2 -5 .75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>24 0.35 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>24 0.35 1.5</size></box></geometry><material><ambient>.28 .25 .20 1</ambient><diffuse>.28 .25 .20 1</diffuse></material></visual></link></model>
<model name="wall2"><static>true</static><pose>10 0 .75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.35 10 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 10 1.5</size></box></geometry><material><ambient>.28 .25 .20 1</ambient><diffuse>.28 .25 .20 1</diffuse></material></visual></link></model>
<model name="wall3"><static>true</static><pose>-8 3 .75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.35 4 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 4 1.5</size></box></geometry><material><ambient>.28 .25 .20 1</ambient><diffuse>.28 .25 .20 1</diffuse></material></visual></link></model>
<model name="wall4"><static>true</static><pose>-2 1.5 .75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>8 0.35 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>8 0.35 1.5</size></box></geometry><material><ambient>.28 .25 .20 1</ambient><diffuse>.28 .25 .20 1</diffuse></material></visual></link></model>
<!-- Northern gas divider: keep the southern mission and return area open. -->
<model name="wall5"><static>true</static><pose>2 1.5 .75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>3.5 0.35 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>3.5 0.35 1.5</size></box></geometry><material><ambient>.28 .25 .20 1</ambient><diffuse>.28 .25 .20 1</diffuse></material></visual></link></model>
<model name="wall6"><static>true</static><pose>0 3 .75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.35 4 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 4 1.5</size></box></geometry><material><ambient>.28 .25 .20 1</ambient><diffuse>.28 .25 .20 1</diffuse></material></visual></link></model>
<!-- Eastern opening: leave 4.65 m between the vertical wall end and the southern divider. -->
<model name="wall7"><static>true</static><pose>5 3 .75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.35 4 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>0.35 4 1.5</size></box></geometry><material><ambient>.28 .25 .20 1</ambient><diffuse>.28 .25 .20 1</diffuse></material></visual></link></model>
<!-- Short southern divider leaves the eastern victim room open for turning and departure. -->
<model name="wall8"><static>true</static><pose>5 -4 .75 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>3 0.35 1.5</size></box></geometry></collision><visual name="v"><geometry><box><size>3 0.35 1.5</size></box></geometry><material><ambient>.28 .25 .20 1</ambient><diffuse>.28 .25 .20 1</diffuse></material></visual></link></model>

<include><uri>model://writer</uri><name>writer</name><pose>-11 0 .1 0 0 0</pose></include><include><uri>model://executor</uri><name>executor</name><pose>-13 -2 .22 0 0 0</pose></include><include><uri>model://firebot</uri><name>firebot</name><pose>-13 2 .22 0 0 0</pose></include>
<model name="victim_V01"><static>true</static><pose>7.24 -0.36 .4 0 0 0</pose><link name="l"><visual name="v"><geometry><sphere><radius>.4</radius></sphere></geometry><material><ambient>.1 .9 .25 1</ambient><diffuse>.1 .9 .25 1</diffuse></material></visual></link></model>
<model name="victim_V02"><static>true</static><pose>-1.5 -0.2 .4 0 0 0</pose><link name="l"><visual name="v"><geometry><sphere><radius>.4</radius></sphere></geometry><material><ambient>.1 .9 .25 1</ambient><diffuse>.1 .9 .25 1</diffuse></material></visual></link></model>
<model name="gas_H01"><static>true</static><pose>3.5 3.1 .08 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>1.0</radius><length>.05</length></cylinder></geometry><material><ambient>.9 .15 .12 .45</ambient><diffuse>.9 .15 .12 .45</diffuse></material></visual></link></model>
<model name="gas_H02"><static>true</static><pose>-4.5 3.2 .08 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>1.0</radius><length>.05</length></cylinder></geometry><material><ambient>.9 .15 .12 .45</ambient><diffuse>.9 .15 .12 .45</diffuse></material></visual></link></model>
<model name="fire_F01"><static>true</static><pose>1.5 -3.9 .08 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>0.8</radius><length>.05</length></cylinder></geometry><material><ambient>1 .5 .05 .6</ambient><diffuse>1 .5 .05 .6</diffuse></material></visual></link></model>
<model name="gateway"><static>true</static><pose>-12.5 0 .4 0 0 0</pose><link name="l"><visual name="v"><geometry><cylinder><radius>.18</radius><length>.8</length></cylinder></geometry><material><ambient>.1 .8 .9 1</ambient><diffuse>.1 .8 .9 1</diffuse></material></visual></link></model>
</world></sdf>
