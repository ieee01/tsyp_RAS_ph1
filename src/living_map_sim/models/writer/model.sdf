<?xml version="1.0"?>
<!-- LivingMap Writer: DARPA SubT X2 robot (OpenRobotics/X2 Config 8 on Gazebo Fuel, CC-BY-4.0). Chassis, wheels and
     physics are the original SubT links; sensors are replaced by the LivingMap LiDAR and
     the skid-steer DiffDrive/odometry plugins use the /writer/* bridge contract. -->
<sdf version="1.9">
  <model name="writer">
    <!-- Robot geometry scaled x1.5 from the original model (poses, shapes, meshes, wheels); mass kept, inertia x1.5^2. -->
    <link name="base_link">
      <inertial>
        <pose>0.0179985 0.003 0.100494 0 -0 0</pose>
        <mass>16.524</mass>
        <inertia>
          <ixx>0.721361</ixx>
          <ixy>-0.00180005</ixy>
          <ixz>0.0368982</ixz>
          <iyy>0.898211</iyy>
          <iyz>-0.0020253</iyz>
          <izz>1.02488</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <pose>0 0 0.138 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.63 0.465 0.276</size>
          </box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <pose>0 0 -0.09825 1.5708 0 -1.5708</pose>
        <geometry>
          <mesh>
            <uri>model://writer/meshes/x2_chassis.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </visual>
      <visual name="center_left_headlight_visual">
        <pose>0.33 0.075 0.12675 0 -0 -3.14159</pose>
        <geometry>
          <mesh>
            <uri>model://writer/meshes/headlight.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </visual>
      <visual name="left_headlight_visual">
        <pose>0.33 0.2175 0.12675 0 -0 -3.14159</pose>
        <geometry>
          <mesh>
            <uri>model://writer/meshes/headlight.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </visual>
      <visual name="center_right_headlight_visual">
        <pose>0.33 -0.075 0.12675 0 -0 -3.14159</pose>
        <geometry>
          <mesh>
            <uri>model://writer/meshes/headlight.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </visual>
      <visual name="right_headlight_visual">
        <pose>0.33 -0.2175 0.12675 0 -0 -3.14159</pose>
        <geometry>
          <mesh>
            <uri>model://writer/meshes/headlight.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <link name="front_left_wheel">
      <pose>0.1965 0.281693 0.05175 0 -0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia>
          <ixx>0.002925</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0054</iyy>
          <iyz>0</iyz>
          <izz>0.002925</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.06</length>
            <radius>0.147</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <slip1>0.0026</slip1>
              <slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 -0 0</pose>
        <geometry>
          <mesh>
            <uri>model://writer/meshes/x2_wheel_left.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <link name="front_right_wheel">
      <pose>0.1965 -0.281693 0.05175 0 -0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia>
          <ixx>0.002925</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0054</iyy>
          <iyz>0</iyz>
          <izz>0.002925</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.06</length>
            <radius>0.147</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <slip1>0.0026</slip1>
              <slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 -0 0</pose>
        <geometry>
          <mesh>
            <uri>model://writer/meshes/x2_wheel_right.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <link name="rear_left_wheel">
      <pose>-0.1965 0.281693 0.05175 0 -0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia>
          <ixx>0.002925</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0054</iyy>
          <iyz>0</iyz>
          <izz>0.002925</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.06</length>
            <radius>0.147</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <slip1>0.0026</slip1>
              <slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 -0 0</pose>
        <geometry>
          <mesh>
            <uri>model://writer/meshes/x2_wheel_left.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <link name="rear_right_wheel">
      <pose>-0.1965 -0.281693 0.05175 0 -0 0</pose>
      <inertial>
        <mass>0.477</mass>
        <inertia>
          <ixx>0.002925</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0054</iyy>
          <iyz>0</iyz>
          <izz>0.002925</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 -0 0</pose>
        <geometry>
          <cylinder>
            <length>0.06</length>
            <radius>0.147</radius>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <slip1>0.0026</slip1>
              <slip2>0</slip2>
              <fdir1>0 0 1</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 -0 0</pose>
        <geometry>
          <mesh>
            <uri>model://writer/meshes/x2_wheel_right.dae</uri>
            <scale>1.5 1.5 1.5</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <child>front_left_wheel</child>
      <parent>base_link</parent>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>+1.79769e+308</upper>
        </limit>
      </axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rear_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>+1.79769e+308</upper>
        </limit>
      </axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>front_right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>+1.79769e+308</upper>
        </limit>
      </axis>
    </joint>
    <link name="laser">
      <pose>0 0 0.405 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000225</ixx>
          <iyy>0.000225</iyy>
          <izz>0.000225</izz>
        </inertia>
      </inertial>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/writer/scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>.08</min>
            <max>12</max>
            <resolution>.01</resolution>
          </range>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name="laser_fixed" type="fixed">
      <parent>base_link</parent>
      <child>laser</child>
    </joint>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.5634</wheel_separation>
      <wheel_radius>0.147</wheel_radius>
      <max_linear_acceleration>.5</max_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
      <max_linear_velocity>1.2</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <topic>/writer/cmd_vel</topic>
      <odom_topic>/writer/wheel_odom</odom_topic>
      <tf_topic>/writer/tf</tf_topic>
      <frame_id>writer/odom</frame_id>
      <child_frame_id>writer/base_link</child_frame_id>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>writer/base_link</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/writer/world_odom</odom_topic>
    </plugin>
  </model>
</sdf>
