<?xml version="1.0"?>
<package format="3">
  <name>living_map_command_post</name>
  <version>0.1.0</version>
  <description>Independent command-post dashboard beyond the simulated long-distance link.</description>
  <maintainer email="team@example.com">LivingMap Team</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>living_map_dashboard</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>python3-pydantic</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
