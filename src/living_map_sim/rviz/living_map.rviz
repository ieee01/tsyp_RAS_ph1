Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: [/Global Options1, /SLAM Map1, /TF1]
    Tree Height: 520
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 90; 90; 95
      Enabled: true
      Name: Mine grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    - Alpha: 0.8
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: SLAM Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
      Use Timestamp: false
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: Writer LiDAR
      Point Size: 3
      Size (Pixels): 3
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /writer/scan
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 200
      Name: Writer trajectory
      Position Tolerance: 0.03
      Shape:
        Alpha: 1
        Color: 0; 190; 255
        Shaft Length: 0.35
        Shaft Radius: 0.04
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /writer/odom
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 200
      Name: Executor trajectory
      Position Tolerance: 0.03
      Shape:
        Alpha: 1
        Color: 255; 170; 0
        Shaft Length: 0.35
        Shaft Radius: 0.04
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /executor/odom
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 200
      Name: Fire robot trajectory
      Position Tolerance: 0.03
      Shape:
        Alpha: 1
        Color: 230; 40; 30
        Shaft Length: 0.35
        Shaft Radius: 0.04
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /firebot/odom
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Persistent beacons
      Namespaces: {beacon_guidance: true, beacon_labels: true, beacons: true}
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /living_map/beacon_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Detected events
      Namespaces: {event_labels: true, events: true}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /living_map/event_markers
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.6
      Name: Robot frames
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 24; 28
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Mine overview
      Scale: 42
      Target Frame: <Fixed Frame>
      X: 9.2
      Y: 0
      Value: TopDownOrtho (rviz)
    Saved: ~
Window Geometry:
  Height: 860
  Width: 1600
